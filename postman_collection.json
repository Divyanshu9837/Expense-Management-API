{
  "info": {
    "name": "Expense Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "expenseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('userId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create User - duplicate email (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
        }
      }
    },
    {
      "name": "Create User - invalid email (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John\",\n  \"email\": \"abc\"\n}"
        }
      }
    },
    {
      "name": "Create Expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"Lunch\",\n  \"amount\": 350,\n  \"category\": \"Food\",\n  \"description\": \"Lunch with friends\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('expenseId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Expense - invalid amount (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"X\",\n  \"amount\": 0,\n  \"category\": \"Food\"\n}"
        }
      }
    },
    {
      "name": "Create Expense - user not found (404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"64b7f0c2a1b2c3d4e5f60718\",\n  \"title\": \"X\",\n  \"amount\": 10,\n  \"category\": \"Food\"\n}"
        }
      }
    },
    {
      "name": "Get Expenses (paginated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Get Expenses - user + category",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses?userId={{userId}}&category=Food",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            },
            {
              "key": "category",
              "value": "Food"
            }
          ]
        }
      }
    },
    {
      "name": "Get Expenses - date range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses?fromDate=2026-08-01&toDate=2026-12-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "fromDate",
              "value": "2026-08-01"
            },
            {
              "key": "toDate",
              "value": "2026-12-31"
            }
          ]
        }
      }
    },
    {
      "name": "Get Expenses - invalid pagination (400)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses?page=0&limit=abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "abc"
            }
          ]
        }
      }
    },
    {
      "name": "Expense Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/summary?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "summary"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Expense By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    },
    {
      "name": "Get Expense - invalid ID (400)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "123"
          ]
        }
      }
    },
    {
      "name": "Update Expense",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dinner\",\n  \"amount\": 500,\n  \"category\": \"Food\"\n}"
        }
      }
    },
    {
      "name": "Delete Expense",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    },
    {
      "name": "Get Deleted Expense (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    }
  ]
}